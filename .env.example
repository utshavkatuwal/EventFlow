# Copy to .env and fill in real values. Never commit .env.
# Dev default DB is MySQL via docker-compose; SQLite file is handy for quick local runs.
DATABASE_URL=mysql+pymysql://eventflow_user:eventflow_password@localhost:3306/eventflow
# DATABASE_URL=sqlite:///./backend/eventflow.db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eventflow
DB_USER=eventflow_user
DB_PASSWORD=change-me

# REQUIRED in production (min 32 chars). Dev fallback in config.py is NOT for prod.
SECRET_KEY=change-me-please-set-SECRET_KEY-env
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

UPLOAD_DIRECTORY=uploads/
VERIFICATION_DOC_DIR=uploads/verifications/
MAX_UPLOAD_SIZE=10485760

# eSewa TEST/UAT only — set real merchant creds via env in production.
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
ESEWA_STATUS_CHECK=false
# Khalti TEST only — set a real sandbox key via env to enable Khalti.
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://a.khalti.com/api/v2

# Demo accounting defaults (also stored in platform_settings, admin-editable)
PLATFORM_TICKET_FEE=20
WITHDRAWAL_SERVICE_FEE=20
SETTLEMENT_HOLD_DAYS=2

ENVIRONMENT=development
DEBUG=True
